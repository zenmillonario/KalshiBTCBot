@echo off
setlocal DisableDelayedExpansion
title TACHYOS - DIRECT RUN FINDER + ULTRA FORENSICS
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"
set "TR_ROOT=%~dp0"
cd /d "%TR_ROOT%"

set "TR_PY="
set "TR_PY_ARGS="
if exist "C:\KalshiBTCBot\.venv\Scripts\python.exe" (
    set "TR_PY=C:\KalshiBTCBot\.venv\Scripts\python.exe"
    goto python_ready
)
if exist "%TR_ROOT%.venv\Scripts\python.exe" (
    set "TR_PY=%TR_ROOT%.venv\Scripts\python.exe"
    goto python_ready
)
where python >nul 2>&1
if not errorlevel 1 (
    python -c "import sys; raise SystemExit(sys.version_info < (3, 10))" >nul 2>&1
    if not errorlevel 1 (
        set "TR_PY=python"
        goto python_ready
    )
)
where py >nul 2>&1
if not errorlevel 1 (
    py -3 -c "import sys; raise SystemExit(sys.version_info < (3, 10))" >nul 2>&1
    if not errorlevel 1 (
        set "TR_PY=py"
        set "TR_PY_ARGS=-3"
        goto python_ready
    )
)
goto no_python

:python_ready
set "TR_SELF=%~f0"
set "TR_TMP_PY=%TEMP%\tachyos_ultra09_%RANDOM%_%RANDOM%.py"

rem Decode the embedded Base64 bytes exactly. No newline escaping, no module imports, no LAST_RUN dependency.
powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$lines=[IO.File]::ReadAllLines($env:TR_SELF); $marker='#__TACHYOS_B64_PAYLOAD__'; $idx=[Array]::IndexOf($lines,$marker); if($idx -lt 0){Write-Error 'Embedded payload marker missing'; exit 2}; $b64=($lines[($idx+1)..($lines.Length-1)] -join ''); try{$bytes=[Convert]::FromBase64String($b64)}catch{Write-Error 'Embedded payload Base64 decode failed'; exit 3}; [IO.File]::WriteAllBytes($env:TR_TMP_PY,$bytes)"
if errorlevel 1 goto payload_error

"%TR_PY%" %TR_PY_ARGS% -X utf8 -m py_compile "%TR_TMP_PY%"
if errorlevel 1 goto payload_compile_error

"%TR_PY%" %TR_PY_ARGS% -X utf8 "%TR_TMP_PY%" --package-root "%TR_ROOT%" %*
set "TR_RC=%ERRORLEVEL%"
del /q "%TR_TMP_PY%" >nul 2>&1
del /q "%TR_TMP_PY%c" >nul 2>&1
echo.
if "%TR_RC%"=="0" (
    echo Ultra forensic export complete. Upload the *_ULTRA_FORENSICS.zip file printed above.
) else (
    echo Ultra forensic export failed. Review the error above.
)
pause
exit /b %TR_RC%

:no_python
echo A working Python 3.10 or newer was not found.
echo The existing C:\KalshiBTCBot\.venv is preferred.
goto failed

:payload_error
echo Embedded Base64 payload could not be decoded.
goto failed

:payload_compile_error
echo Embedded Python payload decoded but did not compile.
goto failed

:failed
del /q "%TR_TMP_PY%" >nul 2>&1
echo.
pause
exit /b 1

